#!/bin/bash
# ───────────────────────────────────────────────────────────
#  글로닉스 홈페이지 발행 스크립트
#  이 파일을 더블클릭하면: 수정된 파일을 GitHub에 올리고
#  Netlify가 자동으로 사이트를 재배포합니다.
# ───────────────────────────────────────────────────────────

# 스크립트가 있는 폴더로 이동 (어디서 실행해도 동작)
cd "$(dirname "$0")" || exit 1

echo "============================================"
echo "  글로닉스 홈페이지 발행"
echo "============================================"
echo ""

# 변경된 내용이 있는지 확인
if [ -z "$(git status --porcelain)" ]; then
  echo "✅ 변경된 파일이 없습니다. 올릴 내용이 없어요."
  echo ""
  echo "(창을 닫으셔도 됩니다)"
  exit 0
fi

echo "📝 변경된 파일:"
git status --short
echo ""

# 모든 변경사항 스테이징
git add -A

# 현재 시각으로 커밋 메시지 자동 생성
STAMP="$(date '+%Y-%m-%d %H:%M')"
git commit -m "사이트 수정 ($STAMP)"

echo ""
echo "⬆️  GitHub에 올리는 중..."
if git push origin main; then
  echo ""
  echo "============================================"
  echo "  ✅ 발행 완료!"
  echo "  Netlify가 약 30초~1분 후 사이트에 반영합니다."
  echo "  https://www.glonix.co.kr"
  echo "============================================"
else
  echo ""
  echo "============================================"
  echo "  ❌ 올리기 실패 — 인증 또는 네트워크 문제일 수 있습니다."
  echo "  메시지를 캡처해서 Claude에게 알려주세요."
  echo "============================================"
fi

echo ""
echo "(창을 닫으셔도 됩니다)"
